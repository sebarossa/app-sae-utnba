---
import Icon from './Icon.astro';
import Desplegables from './Desplegables.astro';
import type { Area } from '../data/areas';

interface Props {
  convocatoria: NonNullable<Area['convocatoria']>;
  acento?: 'rojo' | 'dorado';
}

const { convocatoria: c, acento = 'rojo' } = Astro.props;
---

<section class:list={['conv', `conv--${acento}`]}>
  <p class="conv__etiqueta">
    <span class="conv__punto" aria-hidden="true"></span>
    {c.etiqueta}
  </p>

  <h2 class="conv__titulo">{c.titulo}</h2>
  <p class="conv__texto">{c.texto}</p>

  <p class="conv__cierre">
    <Icon name="reloj" size={15} />
    <span>{c.cierre}</span>
  </p>

  <a class="conv__btn" href={c.cta.url} target="_blank" rel="noopener">
    {c.cta.texto}
    <Icon name="flecha" size={15} />
  </a>

  <div class="conv__detalles">
    <Desplegables bloques={c.detalles} acento={acento} />
  </div>

  {c.nota && <p class="conv__nota">{c.nota}</p>}
</section>

<style>
  .conv {
    background: var(--panel);
    border: 1px solid var(--linea);
    border-radius: var(--r-lg);
    padding: 20px 18px 22px;
    margin-bottom: 30px;
  }

  /* ── Etiqueta con el punto que late ── */
  .conv__etiqueta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--titulo);
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--rojo);
    margin-bottom: 12px;
  }

  .conv--dorado .conv__etiqueta {
    color: #8a6d24;
  }

  .conv__punto {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--rojo);
    box-shadow: 0 0 0 0 rgba(200, 16, 46, 0.5);
    animation: latido 2.2s ease-out infinite;
  }

  .conv--dorado .conv__punto {
    background: var(--dorado);
    box-shadow: 0 0 0 0 rgba(184, 147, 62, 0.5);
  }

  @keyframes latido {
    0% {
      box-shadow: 0 0 0 0 currentColor;
    }
    70% {
      box-shadow: 0 0 0 7px transparent;
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }

  .conv__titulo {
    font-size: 21px;
    font-weight: 900;
    line-height: 1.22;
  }

  .conv__texto {
    margin: 9px 0 14px;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--gris);
  }

  .conv__cierre {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 9px;
    align-items: start;
    font-size: 13.5px;
    font-weight: 600;
    line-height: 1.5;
    color: var(--tinta);
    margin-bottom: 16px;
  }

  .conv__cierre :global(svg) {
    color: var(--rojo);
    margin-top: 2px;
  }

  .conv--dorado .conv__cierre :global(svg) {
    color: var(--dorado);
  }

  .conv__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 52px;
    padding: 14px 26px;
    border-radius: var(--r-sm);
    background: var(--rojo);
    color: #fff;
    font-family: var(--titulo);
    font-size: 14.5px;
    font-weight: 800;
    transition: transform 0.15s ease;
  }

  .conv__btn:active {
    transform: scale(0.98);
  }

  .conv__detalles {
    margin-top: 18px;
  }

  .conv__nota {
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--linea);
    font-size: 13px;
    line-height: 1.6;
    color: var(--gris);
    word-break: break-word;
  }

  @media (min-width: 520px) {
    .conv__btn {
      display: inline-flex;
    }
  }
</style>
