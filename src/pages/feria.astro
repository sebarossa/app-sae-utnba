---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';

// ─────────────────────────────────────────────────────────────
// SECCIÓN TEMPORAL — Feria de Empleabilidad 2026 (7 y 8 de octubre).
// Como en /ingreso, el contenido vive dentro de este archivo: pasada
// la fecha se borra la página y el banner del inicio, y listo.
// ─────────────────────────────────────────────────────────────

const INSCRIPCION = 'https://luma.com/3unm2j2r';
const CLOUD = 'https://res.cloudinary.com/pu6xe6eg/image/upload';

const empresas = [
  { nombre: 'Molinos Río de la Plata', logo: `${CLOUD}/e_trim/h_82,c_scale,q_auto/v1790788015/logo_molinos.png` },
  { nombre: 'mAbxience', logo: `${CLOUD}/e_trim/h_68,c_scale,q_auto/v1790788015/Logo_MABXIENCE.png` },
  { nombre: 'Novo Space', logo: `${CLOUD}/e_trim/h_44,c_scale,q_auto/v1790788017/Novo_Space_Logo_horizontal_blue.png` },
  { nombre: 'Prysmian', logo: `${CLOUD}/e_trim/h_52,c_scale,q_auto/v1790792469/Logo_-Prysmian_300x300.png` },
  { nombre: 'Andreani', logo: `${CLOUD}/e_trim/h_44,c_scale,q_auto/v1790792443/andreani.png` },
  { nombre: 'Mirgor', logo: `${CLOUD}/e_trim/h_66,c_scale,q_auto/v1790788016/MIRGOR_LOGO-3.png`, fondo: '#12173A' },
  { nombre: 'Swiss Medical', logo: `${CLOUD}/e_trim/h_48,c_scale,q_auto/v1790788016/logo_swiss_medical_curvas.png` },
  { nombre: 'PwC Argentina', logo: `${CLOUD}/w_800,c_scale/e_trim/h_76,c_scale,q_auto/v1790792736/PwC-logo.png` },
  { nombre: 'Chevron', logo: `${CLOUD}/e_trim/h_112,c_scale,q_auto/v1790788014/CVX_Logo_Corp_Flat_Hldgshape_RGB.png` },
  { nombre: 'Datalytics', logo: `${CLOUD}/e_trim/h_104,c_scale,q_auto/v1790788482/datalyticsit_logo.jpg` },
  { nombre: 'Central Puerto', logo: `${CLOUD}/w_1000,c_scale/e_trim/e_replace_color:0b2d5b:25:ffffff/h_62,c_scale,q_auto/v1790792940/logo-footer.png` },
  { nombre: 'Techint', logo: `${CLOUD}/h_112,c_scale,q_auto/v1790788017/Logo_OT_negro_1.jpg` },
  { nombre: 'JPMorgan Chase', logo: `${CLOUD}/c_crop,w_1.0,h_0.22,g_center/h_48,c_scale,q_auto/v1790788020/JPMC_bronze_logo.png` },
  { nombre: 'Terminales Río de la Plata' },
  { nombre: 'SACDE', logo: `${CLOUD}/e_trim/h_50,c_scale,q_auto/v1790788017/sacde_Blue_2.png` },
  { nombre: 'EY', logo: `${CLOUD}/e_trim/h_102,c_scale,q_auto/v1790792434/EY_logo_2019.svg.png` },
  { nombre: 'Coca-Cola FEMSA', logo: `${CLOUD}/e_trim/h_88,c_scale,q_auto/v1790788016/LOGO-_Coca-Cola_FEMSA_1.jpg` },
  { nombre: 'Stellantis', logo: `${CLOUD}/e_trim/h_52,c_scale,q_auto/v1790787981/stellantis_letras_azul_sin_fondo.png` },
  { nombre: 'Banco Patagonia', logo: `${CLOUD}/h_60,c_scale,q_auto/v1790787980/banco_patagonia_letras_blancas_fondo_azul.png`, fondo: '#00457C' },
];

const jornadas = [
  {
    modo: 'Presencial',
    icono: '📍',
    acento: 'rojo' as const,
    fecha: 'Miércoles 7 de octubre',
    hora: '12 a 19 h',
    donde: 'Aula Magna · UTN Buenos Aires · Av. Medrano 951, CABA',
    texto:
      'Recorré los espacios de las empresas, conocé a sus equipos y acercate directamente a las oportunidades disponibles.',
  },
  {
    modo: 'Virtual',
    icono: '💻',
    acento: 'dorado' as const,
    fecha: 'Jueves 8 de octubre',
    donde: 'Online · los accesos llegan por email a quienes se inscriban',
    texto:
      'Participá de charlas y talleres con empresas a lo largo del día, desde donde estés. Cada charla tiene su propia inscripción: elegí las que te interesen.',
  },
];

// Las charlas del jueves, cada una con su formulario.
const logoDe = (nombre: string) => empresas.find((e) => e.nombre === nombre)?.logo;

const charlas = [
  {
    hora: '10 a 11 h',
    empresa: 'Lovelytics',
    titulo: 'Quiero trabajar en datos e IA: por dónde empezar',
    url: 'https://forms.gle/SirSsneXGhXoTxwFA',
    logo: `${CLOUD}/e_trim/h_52,c_scale,q_auto/v1790788015/1.Logo_Lovelytics-black-color.png`,
  },
  {
    hora: '11 a 12 h',
    empresa: 'Coca-Cola FEMSA',
    titulo: 'Del aula a la operación: la ingeniería detrás de cada botella',
    url: 'https://forms.gle/YgS1hpzo8pRSj7Do7',
    logo: logoDe('Coca-Cola FEMSA'),
  },
  {
    hora: '13 a 14 h',
    empresa: 'PwC',
    titulo: 'IA para potenciar tu búsqueda laboral: guía práctica para estudiantes',
    url: 'https://forms.gle/UJDgnrJ1uWT2N8gQ6',
    logo: logoDe('PwC Argentina'),
  },
  {
    hora: '14 a 15 h',
    empresa: 'EY',
    titulo: 'La ciberseguridad en la era de la IA agéntica',
    url: 'https://forms.gle/6XoFryQwz5wybh4u8',
    logo: logoDe('EY'),
  },
  {
    hora: '15 a 16 h',
    empresa: 'Chevron',
    titulo: 'Implementación de nuevas tecnologías y desarrollo con IA',
    url: 'https://forms.gle/v2MxCQyR5RDrm22JA',
    logo: logoDe('Chevron'),
    simultaneo: true,
  },
  {
    hora: '15 a 16 h',
    empresa: 'Swiss Medical',
    titulo: 'Tecnología, innovación y salud',
    url: 'https://forms.gle/kHQ7gzYuCM1bhZRp9',
    logo: logoDe('Swiss Medical'),
    simultaneo: true,
  },
  {
    hora: '16 a 17 h',
    empresa: 'SACDE',
    titulo: 'SACDE en el desarrollo de la infraestructura energética estratégica de la Argentina',
    url: 'https://forms.gle/pyaGHwcE2ArdYDH78',
    logo: logoDe('SACDE'),
    simultaneo: true,
  },
  {
    hora: '16 a 17 h',
    empresa: 'Tetra Pak',
    titulo: 'Tetra Pak y oportunidades para Make an Impact',
    url: 'https://docs.google.com/forms/d/e/1FAIpQLSeKhy68WbIlsEw0baBjOG_UBmNIzepk1IJ4n9UqZP4TMPwQmw/viewform',
    // Sin logo cargado: la tarjeta cae al nombre en texto.
    logo: undefined,
    simultaneo: true,
  },
];

const mitad = Math.ceil(empresas.length / 2);
const hileras = [empresas.slice(0, mitad), empresas.slice(mitad)];

const bloques = [
  {
    icono: '🤝',
    titulo: 'Empresas y oportunidades laborales',
    texto:
      'Conocé presencialmente a empresas de distintas industrias, conversá con sus equipos de Recursos Humanos y descubrí pasantías, primeros empleos, posiciones profesionales y programas de jóvenes talentos.',
  },
  {
    icono: '🧠',
    titulo: 'Conocé mejor tu perfil profesional',
    nuevo: true,
    texto:
      'Este año vas a poder acceder sin costo a una evaluación de habilidades y competencias, pensada para que conozcas tus fortalezas y llegues con más información a tus próximos procesos de selección.',
  },
  {
    icono: '🚀',
    titulo: 'Herramientas para dar el próximo paso',
    texto:
      'La Feria es parte de las iniciativas de UTN.BA para acompañar a estudiantes y graduados en su desarrollo profesional y generar nuevas conexiones con el mundo del trabajo.',
  },
];
---

<Base
  title="Feria de Empleabilidad 2026 — UTN.BA"
  description="7 y 8 de octubre. Empresas que buscan talento UTN, charlas y una evaluación de competencias sin costo. Participación gratuita con inscripción previa."
  volverA="/"
  volverTexto="Inicio"
>
  <section class="cabecera">
    <p class="cabecera__kicker">Feria de Empleabilidad 2026</p>
    <h1 class="cabecera__titulo">Tu próximo desafío profesional puede empezar acá.</h1>
    <p class="cabecera__desc">
      Dos jornadas para conocer a las empresas que están buscando talento, hablar con sus equipos de
      Recursos Humanos y sumar herramientas para tu desarrollo profesional.
    </p>
    <div class="cabecera__pills">
      <span class="pill pill--rojo">Miércoles 7 · Presencial</span>
      <span class="pill pill--dorado">Jueves 8 · Virtual</span>
    </div>
  </section>

  <div class="franja"></div>

  <div class="wrap seccion">
    <p class="intro">
      Es el punto de encuentro entre estudiantes, graduados y algunas de las principales empresas y
      organizaciones del país. El <strong>7 de octubre</strong> en la Sede Medrano, para recorrer los
      stands y conocer a los equipos cara a cara. El <strong>8 de octubre</strong> seguimos online,
      con charlas y talleres a lo largo del día.
    </p>
    <p class="intro">
      Pasantías, primeros empleos, posiciones profesionales y programas de jóvenes talentos: si estás
      pensando en tu próximo paso, este es el lugar para darlo.
    </p>

    <a class="btn btn--primario btn--bloque inscribir" href={INSCRIPCION} target="_blank" rel="noopener">
      Inscribirme a la Feria
      <Icon name="flecha" size={16} />
    </a>
    <p class="inscribir__nota">
      Participación gratuita para estudiantes y graduados, con inscripción previa.
    </p>
  </div>

  <!-- ── QUÉ VAS A ENCONTRAR ──────────────── -->
  <div class="wrap seccion seccion--top">
    <p class="kicker">La Feria</p>
    <h2 class="titulo-seccion">¿Qué vas a encontrar?</h2>
    <ul class="bloques">
      {
        bloques.map((b) => (
          <li class="bloque">
            <span class="bloque__icono" aria-hidden="true">
              {b.icono}
            </span>
            <div>
              <h3 class="bloque__titulo">
                {b.titulo}
                {b.nuevo && <span class="bloque__nuevo">Nuevo</span>}
              </h3>
              <p class="bloque__texto">{b.texto}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>

  <!-- ── DOS JORNADAS ─────────────────────── -->
  <section class="agenda">
    <div class="wrap">
      <p class="kicker kicker--dorado">Agenda</p>
      <h2 class="agenda__titulo">Dos jornadas para participar</h2>

      {
        jornadas.map((j) => (
          <article class:list={['jornada', `jornada--${j.acento}`]}>
            <span class:list={['jornada__modo', `jornada__modo--${j.acento}`]}>
              {j.icono} {j.modo}
            </span>
            <h3 class="jornada__fecha">{j.fecha}</h3>
            {j.hora && <p class="jornada__hora">{j.hora}</p>}
            <p class="jornada__donde">{j.donde}</p>
            <p class="jornada__texto">{j.texto}</p>
          </article>
        ))
      }

      <ul class="charlas">
        {
          charlas.map((c) => (
            <li class="charla">
              <span class="charla__logo">
                {c.logo ? (
                  <img src={c.logo} alt={c.empresa} loading="lazy" decoding="async" />
                ) : (
                  <span class="charla__sigla">{c.empresa}</span>
                )}
              </span>
              <div class="charla__cuerpo">
                <p class="charla__hora">
                  {c.hora} · {c.empresa}
                  {c.simultaneo && <span class="charla__simultaneo">En simultáneo</span>}
                </p>
                <h4 class="charla__titulo">{c.titulo}</h4>
                {c.url ? (
                  <a class="charla__btn" href={c.url} target="_blank" rel="noopener">
                    Inscribirme
                    <Icon name="flecha" size={13} />
                  </a>
                ) : (
                  <p class="charla__pendiente">Inscripción: próximamente</p>
                )}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ── EMPRESAS ─────────────────────────── -->
  <div class="wrap seccion">
    <p class="kicker">Empresas confirmadas</p>
    <h2 class="titulo-seccion">Quiénes te esperan</h2>
    <p class="bajada">Algunas de las organizaciones que ya confirmaron. Y se siguen sumando.</p>

  </div>

  <div class="cinta">
    {
      hileras.map((hilera, i) => (
        <div class:list={['cinta__fila', i % 2 === 1 && 'cinta__fila--vuelta']}>
          <ul class="cinta__pista">
            {[0, 1].map((copia) =>
              hilera.map((e) => (
                <li
                  class="empresa"
                  style={e.fondo ? `background-color:${e.fondo}` : undefined}
                  aria-hidden={copia === 1 ? 'true' : undefined}
                >
                  {e.logo ? (
                    <img src={e.logo} alt={copia === 1 ? '' : e.nombre} decoding="async" />
                  ) : (
                    <span class="empresa__nombre">{e.nombre}</span>
                  )}
                </li>
              ))
            )}
          </ul>
        </div>
      ))
    }
  </div>

  <div class="wrap">
    <p class="empresas__nota">Al inscribirte te enviamos la lista completa de empresas participantes.</p>
  </div>


  <!-- ── CIERRE ───────────────────────────── -->
  <section class="cierre">
    <div class="wrap">
      <p class="kicker">Participación gratuita</p>
      <h2 class="cierre__titulo">Conectamos talento UTN con oportunidades.</h2>
      <p class="cierre__bajada">
        Registrate para recibir por email el cronograma de actividades, las empresas participantes y
        los accesos a las actividades virtuales.
      </p>
      <a class="btn btn--primario btn--bloque" href={INSCRIPCION} target="_blank" rel="noopener">
        Quiero inscribirme
        <Icon name="flecha" size={16} />
      </a>
      <p class="cierre__consultas">
        Consultas: <a href="mailto:sae@frba.utn.edu.ar">sae@frba.utn.edu.ar</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .cabecera {
    background: var(--tinta);
    color: #fff;
    padding: 36px 20px 32px;
  }

  .cabecera__kicker {
    font-family: var(--titulo);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--dorado);
    margin-bottom: 14px;
  }

  .cabecera__titulo {
    font-size: 32px;
    font-weight: 900;
    color: #fff;
    letter-spacing: -0.03em;
    line-height: 1.12;
  }

  .cabecera__desc {
    margin-top: 14px;
    font-size: 15px;
    line-height: 1.7;
    color: #c9cfe0;
  }

  .cabecera__pills {
    display: flex;
    gap: 8px;
    margin-top: 20px;
    flex-wrap: wrap;
  }

  .seccion--top {
    padding-top: 0;
    margin-top: 6px;
    border-top: 1px solid var(--linea);
    padding-block-start: 30px;
  }

  .intro {
    font-size: 15px;
    line-height: 1.75;
    color: var(--tinta-2);
    margin-bottom: 16px;
  }

  .intro strong {
    color: var(--rojo);
  }

  .inscribir {
    margin-top: 10px;
    text-transform: none;
    letter-spacing: 0.01em;
    font-size: 15px;
  }

  .inscribir__nota {
    margin-top: 12px;
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--gris-2);
    text-align: center;
  }

  /* ── Qué vas a encontrar ── */
  .bloques {
    display: grid;
    gap: 2px;
    margin-top: 18px;
  }

  .bloque {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 14px;
    align-items: start;
    padding: 16px 0;
    border-bottom: 1px solid var(--linea);
  }

  .bloque:last-child {
    border-bottom: none;
  }

  .bloque__icono {
    font-size: 21px;
    line-height: 1.2;
  }

  .bloque__titulo {
    font-size: 16px;
    font-weight: 800;
    line-height: 1.35;
  }

  .bloque__nuevo {
    display: inline-block;
    vertical-align: middle;
    margin-left: 7px;
    border-radius: 4px;
    padding: 3px 8px;
    background: var(--rojo);
    color: #fff;
    font-size: 9.5px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .bloque__texto {
    margin-top: 6px;
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--gris);
  }

  /* ── Agenda ── */
  .agenda {
    background: var(--tinta);
    padding-block: 32px 36px;
  }

  .agenda__titulo {
    font-size: 24px;
    font-weight: 900;
    color: #fff;
    margin-bottom: 18px;
  }

  .jornada {
    background: var(--blanco);
    border-radius: var(--r-md);
    padding: 20px 18px;
    margin-bottom: 12px;
  }

  .jornada--dorado {
    background: var(--panel);
  }

  .charlas {
    display: grid;
    gap: 10px;
    margin-top: 14px;
  }

  .charla {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 14px;
    align-items: start;
    background: #1c2434;
    border-radius: var(--r-md);
    padding: 15px 16px;
  }

  .charla__logo {
    display: grid;
    place-items: center;
    width: 62px;
    height: 56px;
    padding: 0 6px;
    border-radius: 8px;
    background: #fff;
    flex: none;
  }

  .charla__logo img {
    max-width: 100%;
    max-height: 34px;
    width: auto;
    height: auto;
  }

  .charla__sigla {
    font-family: var(--titulo);
    font-size: 11px;
    font-weight: 800;
    color: var(--tinta);
    text-align: center;
    line-height: 1.25;
  }

  .charla__cuerpo {
    min-width: 0;
  }

  .charla__hora {
    font-family: var(--titulo);
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #ff8fa0;
    line-height: 1.4;
  }

  .charla__simultaneo {
    display: inline-block;
    margin-left: 6px;
    border-radius: 4px;
    padding: 2px 7px;
    background: rgba(184, 147, 62, 0.2);
    color: #d4aa5a;
    font-size: 9.5px;
    letter-spacing: 0.08em;
  }

  .charla__titulo {
    margin-top: 5px;
    font-family: var(--titulo);
    font-size: 15px;
    font-weight: 800;
    color: #fff;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .charla__btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 12px;
    padding: 10px 18px;
    border-radius: var(--r-sm);
    background: var(--rojo);
    color: #fff;
    font-family: var(--titulo);
    font-size: 12.5px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .charla__btn:active {
    transform: scale(0.98);
  }

  .charla__pendiente {
    display: inline-block;
    margin-top: 12px;
    padding: 9px 16px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: var(--r-sm);
    font-family: var(--titulo);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #9aa4ba;
  }

  .jornada__modo {
    display: inline-block;
    border-radius: 4px;
    padding: 5px 10px;
    font-family: var(--titulo);
    font-size: 9.5px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fff;
  }

  .jornada__modo--rojo {
    background: var(--rojo);
  }

  .jornada__modo--dorado {
    background: var(--dorado);
  }

  .jornada__fecha {
    font-size: 19px;
    font-weight: 800;
    margin-top: 12px;
    letter-spacing: -0.02em;
  }

  .jornada__hora {
    margin-top: 2px;
    font-family: var(--titulo);
    font-size: 16px;
    font-weight: 800;
    color: var(--rojo);
    letter-spacing: -0.01em;
  }

  .jornada__donde {
    margin-top: 4px;
    font-size: 13px;
    color: var(--gris);
    line-height: 1.5;
  }

  .jornada__texto {
    margin-top: 10px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--tinta-2);
  }

  /* ── Empresas ── */
  .cinta {
    margin-top: 20px;
    display: grid;
    gap: 10px;
    /* Difumina los bordes para que los logos entren y salgan, no se corten. */
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 48px, #000 calc(100% - 48px), transparent);
    mask-image: linear-gradient(90deg, transparent, #000 48px, #000 calc(100% - 48px), transparent);
  }

  .cinta__fila {
    overflow: hidden;
  }

  .cinta__pista {
    display: flex;
    width: max-content;
    gap: 10px;
    /* La pista lleva dos copias de la hilera: al correr media pista,
       vuelve al punto de partida y el ciclo no se nota. */
    animation: desfile 52s linear infinite;
    will-change: transform;
  }

  .cinta__fila--vuelta .cinta__pista {
    animation-direction: reverse;
  }

  @keyframes desfile {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(calc(-50% - 5px), 0, 0);
    }
  }

  @media (hover: hover) {
    .cinta:hover .cinta__pista {
      animation-play-state: paused;
    }
  }

  .empresa {
    flex: none;
    display: grid;
    place-items: center;
