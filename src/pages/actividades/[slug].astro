---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { ACTIVIDADES } from '../../data/actividades';

export function getStaticPaths() {
  return ACTIVIDADES.map((actividad) => ({ params: { slug: actividad.slug }, props: { actividad } }));
}

const { actividad } = Astro.props;
---

<Base
  title={`${actividad.nombre} — SAE UTN.BA`}
  description={actividad.resumen}
  volverA="/"
  volverTexto="Inicio"
>
  <section class="cabecera">
    <p class="cabecera__kicker">{actividad.hero.kicker}</p>
    <h1 class="cabecera__titulo">{actividad.hero.titulo}</h1>
    <p class="cabecera__desc">{actividad.hero.texto}</p>
    <div class="cabecera__pills">
      {
        actividad.hero.pills.map((p, i) => (
          <span class:list={['pill', i === 0 ? 'pill--rojo' : 'pill--dorado']}>{p}</span>
        ))
      }
    </div>
  </section>

  <div class="franja"></div>

  <!-- ── DE QUÉ SE TRATA ──────────────────── -->
  <div class="wrap seccion">
    {actividad.intro.map((parrafo) => <p class="intro">{parrafo}</p>)}

    <a
      class="btn btn--primario btn--bloque inscribir"
      href={actividad.inscripcion.url}
      target="_blank"
      rel="noopener"
    >
      {actividad.inscripcion.cta}
      <Icon name="flecha" size={16} />
    </a>
  </div>

  <!-- ── CUÁNDO Y DÓNDE ───────────────────── -->
  <section class="agenda">
    <div class="wrap">
      <p class="kicker kicker--dorado">Cuándo y dónde</p>
      <h2 class="agenda__titulo">Te esperamos en Medrano</h2>
      <dl class="datos">
        {
          actividad.datos.map((d) => (
            <div class="datos__fila">
              <dt>{d.clave}</dt>
              <dd>{d.valor}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- ── DISERTANTE ───────────────────────── -->
  {
    actividad.disertante && (
      <div class="wrap seccion">
        <p class="kicker">Disertante</p>
        <h2 class="titulo-seccion">{actividad.disertante.nombre}</h2>
        <p class="disertante">{actividad.disertante.texto}</p>
      </div>
    )
  }

  <!-- ── TEMARIO ──────────────────────────── -->
  {
    actividad.temario && (
      <section class="temario">
        <div class="wrap">
          <p class="kicker">Temario</p>
          <h2 class="titulo-seccion">De qué vamos a hablar</h2>
          <ol class="temas">
            {actividad.temario.map((t, i) => (
              <li class:list={['tema', i === actividad.temario!.length - 1 && 'tema--final']}>
                <h3 class="tema__titulo">
                  <span class="tema__num">{i + 1}</span>
                  {t.titulo}
                </h3>
                <p class="tema__texto">{t.texto}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  <!-- ── CIERRE ───────────────────────────── -->
  <section class="cierre">
    <div class="wrap">
      <p class="kicker">{actividad.cuando} · {actividad.donde}</p>
      <h2 class="cierre__titulo">Reservá tu lugar</h2>
      <p class="cierre__bajada">{actividad.inscripcion.texto}</p>
      <a
        class="btn btn--primario btn--bloque"
        href={actividad.inscripcion.url}
        target="_blank"
        rel="noopener"
      >
        {actividad.inscripcion.cta}
        <Icon name="flecha" size={16} />
      </a>
      <p class="cierre__consultas">
        Consultas: <a href="mailto:sae@frba.utn.edu.ar">sae@frba.utn.edu.ar</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .cabecera {
    background: var(--tinta);
    color: #fff;
    padding: 36px 20px 32px;
  }

  .cabecera__kicker {
    font-family: var(--titulo);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--dorado);
    margin-bottom: 14px;
  }

  .cabecera__titulo {
    font-size: 31px;
    font-weight: 900;
    color: #fff;
    letter-spacing: -0.03em;
    line-height: 1.14;
  }

  .cabecera__desc {
    margin-top: 14px;
    font-size: 15px;
    line-height: 1.7;
    color: #c9cfe0;
  }

  .cabecera__pills {
    display: flex;
    gap: 8px;
    margin-top: 20px;
    flex-wrap: wrap;
  }

  .intro {
    font-size: 15px;
    line-height: 1.75;
    color: var(--tinta-2);
    margin-bottom: 16px;
  }

  .inscribir {
    margin-top: 10px;
    text-transform: none;
    letter-spacing: 0.01em;
    font-size: 15px;
  }

  /* ── Cuándo y dónde ── */
  .agenda {
    background: var(--tinta);
    padding-block: 32px 36px;
  }

  .agenda__titulo {
    font-size: 24px;
    font-weight: 900;
    color: #fff;
    margin-bottom: 18px;
  }

  .datos {
    margin: 0;
    background: #fff;
    border-radius: var(--r-md);
    overflow: hidden;
  }

  .datos__fila {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 12px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--linea);
  }

  .datos__fila:last-child {
    border-bottom: none;
  }

  .datos__fila dt {
    font-family: var(--titulo);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--rojo);
    padding-top: 2px;
  }

  .datos__fila:last-child dt {
    color: var(--dorado);
  }

  .datos__fila dd {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--tinta-2);
  }

  /* ── Disertante ── */
  .disertante {
    margin-top: 16px;
    padding: 18px 16px;
    background: var(--panel);
    border-left: 4px solid var(--rojo);
    border-radius: var(--r-md);
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--gris);
  }

  /* ── Temario ── */
  .temario {
    background: var(--panel);
    border-block: 1px solid var(--linea);
    padding-block: 32px 36px;
  }

  .temas {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }

  .tema {
    background: #fff;
    border-radius: var(--r-md);
    border-left: 4px solid var(--rojo);
    padding: 18px 16px;
  }

  .tema--final {
    border-left-color: var(--dorado);
  }

  .tema__titulo {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 10px;
    align-items: center;
    font-size: 16px;
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .tema__num {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--rojo);
    color: #fff;
    font-size: 13px;
    font-weight: 800;
    flex: none;
  }

  .tema--final .tema__num {
    background: var(--dorado);
  }

  .tema__texto {
    margin-top: 9px;
    font-size: 14px;
    line-height: 1.65;
    color: var(--gris);
  }

  /* ── Cierre ── */
  .cierre {
    background: var(--blanco);
    padding-block: 32px 36px;
    text-align: center;
  }

  .cierre__titulo {
    font-size: 22px;
    font-weight: 900;
    line-height: 1.25;
  }

  .cierre__bajada {
    margin: 12px 0 20px;
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--gris);
  }

  .cierre .btn {
    text-transform: none;
    letter-spacing: 0.01em;
    font-size: 15px;
  }

  .cierre__consultas {
    margin-top: 14px;
    font-size: 12.5px;
    color: var(--gris-2);
  }

  .cierre__consultas a {
    color: var(--rojo);
    font-weight: 600;
  }

  @media (min-width: 520px) {
    .cabecera {
      padding: 48px 24px 42px;
    }
    .cabecera__titulo {
      font-size: 38px;
    }
    .inscribir,
    .cierre .btn {
      display: inline-flex;
      width: auto;
    }
  }
</style>
