---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Desplegables from '../components/Desplegables.astro';
import { telHref } from '../lib/tel';

// ─────────────────────────────────────────────────────────────
// SECCIÓN TEMPORAL — Ingreso 2027.
// El contenido vive acá adentro a propósito: cuando pase la fecha,
// se borra este archivo y la entrada "Ingreso" del nav en Base.astro,
// y no queda nada suelto en src/data.
// Fuente: Instructivo Ingreso 2027 (vigencia mayo 2026).
// ─────────────────────────────────────────────────────────────

const PREINSCRIPCION = 'https://guarani.frba.utn.edu.ar/preinscripcion/utn';
const AUTOGESTION = 'https://guarani.frba.utn.edu.ar/autogestion/aspirantes';
const VENTANILLA = 'https://frba.utn.edu.ar/ventanilla-virtual/';

const documentacion = [
  {
    titulo: 'Qué documentación tenés que subir',
    texto:
      'Son tres archivos, de 2 MB como máximo cada uno. Conviene subirlos en PDF, escaneados o con una app tipo CamScanner.',
    items: [
      '1er archivo: DNI frente y dorso, constancia de CUIL y partida de nacimiento, los tres en el mismo PDF. Si sos extranjero, la documentación equivalente.',
      '2do archivo: foto 4x4 tipo carnet. Solo el rostro, de frente, con buena visibilidad y fondo claro y liso.',
      '3er archivo: si ya terminaste el secundario, título o certificado analítico frente y dorso, o constancia de título en trámite. Si todavía no lo terminaste, constancia de que estás cursando el último año.',
    ],
  },
];

const opciones = [
  {
    etiqueta: 'Opción 1',
    modalidad: 'Modalidad libre',
    periodo: 'Octubre a diciembre de 2026',
    titulo: 'Actividades virtuales + Evaluación Diagnóstica',
    texto:
      'Actividades formativas virtuales de Matemática durante octubre y noviembre. Hay que completarlas para poder presentarse a la evaluación, que es presencial. No son clases tradicionales: son actividades para que midas solo cómo estás parado.',
    fechas: [
      { cuando: '1 de septiembre al 9 de octubre de 2026', que: 'Inscripción web' },
      { cuando: '14 de octubre', que: 'Te llega la notificación para entrar al Campus Virtual' },
      { cuando: '15 de octubre', que: 'Empiezan las actividades' },
      {
        cuando: '4 de diciembre, 8:30 o 14:00 h',
        que: 'Evaluación Diagnóstica, presencial en Sede Campus',
      },
    ],
    nota: 'Hay que completar los cuestionarios del aula virtual para poder presentarte a la evaluación.',
  },
  {
    etiqueta: 'Opción 2',
    modalidad: 'Modalidad curso',
    periodo: 'Enero a marzo de 2027',
    titulo: 'Curso de Verano',
    texto:
      'Matemática presencial en la Sede Campus, con tres encuentros semanales. Se cursa antes de empezar primer año.',
    fechas: [
      { cuando: '1 de septiembre al 16 de diciembre de 2026', que: 'Inscripción web' },
      { cuando: '18 de diciembre, desde las 17 h', que: 'Te confirman turno y aula' },
      { cuando: '25 de enero al 12 de marzo de 2027', que: 'Cursada' },
    ],
    horarios: ['Mañana: 8:30 a 12:30 h', 'Tarde: 14:00 a 18:00 h', 'Noche: 19:00 a 23:00 h'],
    nota: 'La inscripción al Curso de Verano se habilita después de que abra la preinscripción a la Facultad.',
  },
];

const documentos = [
  {
    titulo: 'Instructivo Ingreso 2027',
    texto: 'Documentación a presentar, fechas y alternativas.',
    url: 'https://drive.google.com/file/d/1diDWJH8Y0LZ98pSUGMConC6fmGVkLCxK/view',
  },
  {
    titulo: 'Programa analítico de Matemática',
    texto: 'Los contenidos que entran en el Seminario.',
    url: 'https://drive.google.com/file/d/1na8O67ZkZCGct8Hfl1211scIFQMtU5RR/view',
  },
];

const oficinas = [
  {
    sede: 'Sede Campus',
    lugar: 'Planta baja, Of. 11',
    direccion: 'Mozart 2300, entre Saraza y Santiago de Compostela',
    tel: '011 4638 8838',
  },
  {
    sede: 'Sede Medrano',
    lugar: '3er piso, Of. 308',
    direccion: 'Av. Medrano 951',
    tel: '011 4867 7566',
  },
];
---

<Base
  title="Ingreso 2027 — UTN.BA"
  description="Preinscripción, Seminario Universitario y fechas del Ingreso 2027 a las carreras de ingeniería de la UTN.BA."
>
  <section class="cabecera">
    <p class="cabecera__kicker">Carreras de ingeniería</p>
    <h1 class="cabecera__titulo">Ingreso 2027</h1>
    <p class="cabecera__desc">
      El Seminario Universitario tiene dos materias: <strong>Matemática</strong> y el <strong>
        Taller de Inicio a la Vida Universitaria</strong>, que se cursa después de aprobar
      Matemática. Para llegar ahí hay dos pasos, y después elegís cómo rendir.
    </p>
    <div class="cabecera__pills">
      <span class="pill pill--rojo">Preinscripción abierta</span>
      <span class="pill pill--dorado">Hasta el 4 de diciembre</span>
    </div>
  </section>

  <div class="franja"></div>

  <div class="wrap seccion">
    <!-- ── ANTES QUE NADA: QUÉ CARRERA ────── -->
    <a class="carreras-link" href="/ingreso/carreras">
      <span class="carreras-link__texto">
        <span class="carreras-link__kicker">Antes de decidir</span>
        <span class="carreras-link__titulo">¿Qué ingeniería estudio?</span>
        <span class="carreras-link__desc">
          Las nueve carreras contadas por los directores de cada departamento, con video y plan de
          estudios.
        </span>
      </span>
      <Icon name="flecha" size={18} />
    </a>

    <!-- ── PASO 1 ─────────────────────────── -->
    <section class="paso">
      <div class="paso__cab">
        <span class="paso__num" aria-hidden="true">1</span>
        <div>
          <p class="kicker">Preinscripción</p>
          <h2 class="paso__titulo">Registrate en la Facultad</h2>
        </div>
      </div>

      <p class="paso__texto">
        Es virtual y es lo que habilita todo lo demás. Generás tu usuario y adjuntás la
        documentación.
      </p>
      <p class="paso__fecha">
        <Icon name="reloj" size={15} />
        <span>Del 27 de agosto, 10 h, al 4 de diciembre de 2026</span>
      </p>

      <a class="btn btn--primario btn--bloque paso__btn" href={PREINSCRIPCION} target="_blank" rel="noopener">
        Preinscribirme
        <Icon name="flecha" size={16} />
      </a>

      <div class="paso__docs">
        <Desplegables bloques={documentacion} />
      </div>

      <p class="paso__nota">
        Una vez procesada y confirmada tu preinscripción, dentro de las 96 h hábiles te llega un
        correo con los pasos a seguir.
      </p>
    </section>

    <!-- ── PASO 2 ─────────────────────────── -->
    <section class="paso">
      <div class="paso__cab">
        <span class="paso__num" aria-hidden="true">2</span>
        <div>
          <p class="kicker">Autogestión</p>
          <h2 class="paso__titulo">Elegí cómo rendir Matemática</h2>
        </div>
      </div>

      <p class="paso__texto">
        Con el usuario ya generado, entrás a Autogestión Aspirantes y elegís la modalidad libre o la
        modalidad curso.
      </p>

      <a class="btn btn--primario btn--bloque paso__btn" href={AUTOGESTION} target="_blank" rel="noopener">
        Entrar a Autogestión
        <Icon name="flecha" size={16} />
      </a>

      <p class="paso__nota destacada">
        Las dos modalidades <strong>no son excluyentes</strong>: podés anotarte a las dos y usar la
        segunda si la primera no sale.
      </p>
    </section>

    <!-- ── LAS DOS MODALIDADES ────────────── -->
    <section class="opciones">
      <p class="kicker">Las dos modalidades</p>
      <h2 class="titulo-seccion">Matemática</h2>
      <p class="bajada">
        Son dos caminos hacia lo mismo. Si el primero no te sale, el segundo te sigue esperando.
      </p>

      {
        opciones.map((op) => (
          <article class="opcion">
            <div class="opcion__cab">
              <span class="opcion__etiqueta">{op.etiqueta}</span>
              <span class="opcion__periodo">{op.periodo}</span>
            </div>
            <p class="opcion__modalidad">{op.modalidad}</p>
            <h3 class="opcion__titulo">{op.titulo}</h3>
            <p class="opcion__texto">{op.texto}</p>

            <ul class="fechas">
              {op.fechas.map((f) => (
                <li class="fecha">
                  <span class="fecha__cuando">{f.cuando}</span>
                  <span class="fecha__que">{f.que}</span>
                </li>
              ))}
            </ul>

            {op.horarios && (
              <div class="turnos">
                <p class="turnos__titulo">Turnos</p>
                <ul class="turnos__lista">
                  {op.horarios.map((h) => (
                    <li>{h}</li>
                  ))}
                </ul>
              </div>
            )}

            <p class="opcion__nota">{op.nota}</p>
          </article>
        ))
      }

      <p class="puente">
        <strong>Si no aprobás, no se termina acá.</strong> Quien complete las actividades, rinda el 4
        de diciembre y no apruebe —o no se presente— puede inscribirse igual al Curso de Verano. Y
        quien no apruebe el Curso de Verano tiene dos instancias de Evaluación Diagnóstica Libre en
        marzo de 2027, con fechas a confirmar en febrero.
      </p>
    </section>

    <!-- ── DOCUMENTOS ─────────────────────── -->
    <section class="docs">
      <p class="kicker">Para leer con tiempo</p>
      <h2 class="titulo-seccion">Documentos</h2>
      <ul class="docs__lista">
        {
          documentos.map((d) => (
            <li>
              <a class="doc" href={d.url} target="_blank" rel="noopener">
                <span class="doc__icono">
                  <Icon name="documento" size={18} />
                </span>
                <span class="doc__texto">
                  <span class="doc__titulo">{d.titulo}</span>
                  <span class="doc__desc">{d.texto}</span>
                </span>
                <Icon name="flecha" size={15} />
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- ── OFICINAS DE INGRESO ────────────── -->
    <section class="docs">
      <p class="kicker">Dónde consultar</p>
      <h2 class="titulo-seccion">Oficinas de ingreso</h2>
      <ul class="docs__lista">
        {
          oficinas.map((o) => (
            <li>
              <a class="doc" href={telHref(o.tel)}>
                <span class="doc__icono">
                  <Icon name="tel" size={18} />
                </span>
                <span class="doc__texto">
                  <span class="doc__titulo">
                    {o.sede} · {o.lugar}
                  </span>
                  <span class="doc__desc">
                    {o.tel} · {o.direccion}
                  </span>
                </span>
                <Icon name="flecha" size={15} />
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>

  <!-- ── CONSULTAS ────────────────────────── -->
  <section class="cierre">
    <div class="wrap">
      <p class="kicker kicker--dorado">¿Dudas?</p>
      <h2 class="cierre__titulo">Escribinos por la ventanilla virtual</h2>
      <p class="cierre__bajada">
        Las consultas sobre el ingreso se responden por la Ventanilla de Atención Virtual de la
        Secretaría de Planeamiento y Gestión de Procesos.
      </p>
      <a class="btn btn--primario btn--bloque" href={VENTANILLA} target="_blank" rel="noopener">
        Ir a la ventanilla virtual
        <Icon name="flecha" size={16} />
      </a>
    </div>
  </section>
</Base>

<style>
  .cabecera {
    background: var(--tinta);
    color: #fff;
    padding: 36px 20px 32px;
  }

  .cabecera__kicker {
    font-family: var(--titulo);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--dorado);
    margin-bottom: 14px;
  }

  .cabecera__titulo {
    font-size: 36px;
    font-weight: 900;
    color: #fff;
    letter-spacing: -0.03em;
  }

  .cabecera__desc {
    margin-top: 13px;
    font-size: 15px;
    line-height: 1.7;
    color: #c9cfe0;
  }

  .cabecera__desc strong {
    color: #fff;
    font-weight: 600;
  }

  .cabecera__pills {
    display: flex;
    gap: 8px;
    margin-top: 20px;
    flex-wrap: wrap;
  }

  .carreras-link {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 14px;
    padding: 18px 16px;
    margin-bottom: 26px;
    border: 1px solid var(--linea);
    border-left: 3px solid var(--dorado);
    border-radius: var(--r-md);
    background: var(--blanco);
    box-shadow: var(--sombra-sm);
    color: var(--gris-2);
    transition: box-shadow 0.16s ease, transform 0.16s ease;
  }

  .carreras-link:active {
    transform: scale(0.99);
  }

  @media (hover: hover) {
    .carreras-link:hover {
      box-shadow: var(--sombra-md);
    }
  }

  .carreras-link__kicker {
    display: block;
    font-family: var(--titulo);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--dorado);
  }

  .carreras-link__titulo {
    display: block;
    font-family: var(--titulo);
    font-size: 18px;
    font-weight: 900;
    color: var(--tinta);
    letter-spacing: -0.02em;
    margin-top: 5px;
  }

  .carreras-link__desc {
    display: block;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--gris);
    margin-top: 4px;
  }

  /* ── Pasos ── */
  .paso {
    background: var(--panel);
    border: 1px solid var(--linea);
    border-radius: var(--r-lg);
    padding: 20px 18px 22px;
    margin-bottom: 14px;
  }

  .paso__cab {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 13px;
    align-items: start;
    margin-bottom: 12px;
  }

  .paso__num {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--rojo);
    color: #fff;
    font-family: var(--titulo);
    font-size: 15px;
    font-weight: 800;
  }

  .paso__titulo {
    font-size: 20px;
    font-weight: 900;
    line-height: 1.2;
  }

  .paso__texto {
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--gris);
    margin-bottom: 14px;
  }

  .paso__fecha {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 9px;
    align-items: start;
    font-size: 13.5px;
    font-weight: 600;
    line-height: 1.5;
    color: var(--tinta);
    margin-bottom: 16px;
  }

  .paso__fecha :global(svg) {
    color: var(--rojo);
    margin-top: 2px;
  }

  .paso__btn {
    text-transform: none;
    letter-spacing: 0.01em;
    font-size: 14.5px;
  }

  .paso__docs {
    margin-top: 16px;
  }

  .paso__nota {
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--linea);
    font-size: 13px;
    line-height: 1.6;
    color: var(--gris);
  }

  .paso__nota.destacada {
    border-top: none;
    background: var(--rojo-tenue);
    border-radius: var(--r-sm);
    padding: 13px 14px;
    color: var(--tinta-2);
    font-size: 13.5px;
  }

  .paso__nota strong {
    color: var(--rojo);
  }

  /* ── Opciones ── */
  .opciones {
    margin-top: 36px;
  }

  .opcion {
    border: 1px solid var(--linea);
    border-left: 3px solid var(--rojo);
    border-radius: var(--r-md);
    background: var(--blanco);
    box-shadow: var(--sombra-sm);
    padding: 18px 16px;
    margin-top: 14px;
  }

  .opcion__cab {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
  }

  .opcion__etiqueta {
    border-radius: 4px;
    padding: 4px 9px;
    background: var(--rojo);
    color: #fff;
    font-family: var(--titulo);
    font-size: 9.5px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .opcion__periodo {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--gris);
  }

  .opcion__modalidad {
    font-family: var(--titulo);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--dorado);
    margin-bottom: 4px;
  }

  .opcion__titulo {
    font-size: 17px;
    font-weight: 800;
    line-height: 1.3;
  }

  .opcion__texto {
    margin: 8px 0 14px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--gris);
  }

  .fechas {
    display: grid;
    gap: 10px;
    padding-top: 14px;
    border-top: 1px solid var(--linea);
  }

  .fecha {
    border-left: 2px solid var(--dorado);
    padding-left: 12px;
  }

  .fecha__cuando {
    display: block;
    font-family: var(--titulo);
    font-size: 13px;
    font-weight: 800;
    color: var(--dorado);
  }

  .fecha__que {
    display: block;
    font-size: 13.5px;
    line-height: 1.45;
    color: var(--tinta-2);
    margin-top: 1px;
  }

  .turnos {
    margin-top: 14px;
    padding: 13px 14px;
    background: var(--panel);
    border-radius: var(--r-sm);
  }

  .turnos__titulo {
    font-family: var(--titulo);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gris-2);
    margin-bottom: 6px;
  }

  .turnos__lista {
    display: grid;
    gap: 3px;
    font-size: 13.5px;
    color: var(--tinta-2);
  }

  .opcion__nota {
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid var(--linea);
    font-size: 13px;
    line-height: 1.55;
    color: var(--gris-2);
  }

  .puente {
    margin-top: 22px;
    padding: 15px 16px;
    background: var(--rojo-tenue);
    border-radius: var(--r-md);
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--tinta-2);
  }

  .puente strong {
    color: var(--rojo);
  }

  /* ── Documentos y oficinas ── */
  .docs {
    margin-top: 36px;
    padding-top: 28px;
    border-top: 1px solid var(--linea);
  }

  .docs__lista {
    display: grid;
    gap: 9px;
    margin-top: 16px;
  }

  .doc {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 13px;
    padding: 14px;
    border: 1px solid var(--linea);
    border-radius: var(--r-md);
    background: var(--blanco);
    color: var(--gris-2);
  }

  .doc__icono {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 9px;
    background: var(--rojo-tenue);
    color: var(--rojo);
    flex: none;
  }

  .doc__texto {
    min-width: 0;
  }

  .doc__titulo {
    display: block;
    font-family: var(--titulo);
    font-size: 14.5px;
    font-weight: 800;
    color: var(--tinta);
    line-height: 1.35;
  }

  .doc__desc {
    display: block;
    font-size: 12.5px;
    color: var(--gris);
    line-height: 1.45;
    margin-top: 2px;
  }

  /* ── Cierre ── */
  .cierre {
    background: var(--panel);
    border-top: 1px solid var(--linea);
    padding-block: 32px 36px;
    text-align: center;
  }

  .cierre__titulo {
    font-size: 22px;
    font-weight: 900;
  }

  .cierre__bajada {
    margin: 10px 0 20px;
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--gris);
  }

  .cierre .btn {
    text-transform: none;
    letter-spacing: 0.01em;
    font-size: 14.5px;
  }

  @media (min-width: 520px) {
    .cabecera {
      padding: 48px 24px 42px;
    }
    .cabecera__titulo {
      font-size: 44px;
    }
    .paso__btn,
    .cierre .btn {
      display: inline-flex;
      width: auto;
    }
  }
</style>
