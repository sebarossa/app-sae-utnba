---
import Base from '../layouts/Base.astro';
import AreaCard from '../components/AreaCard.astro';
import Icon from '../components/Icon.astro';
import { AREAS, SAE } from '../data/areas';
import { viajeDestacado } from '../data/viajes';
import { actividadesDestacadas } from '../data/actividades';

// Cualquier área con una convocatoria vigente se anuncia arriba de la grilla.
const convocatorias = AREAS.filter((a) => a.convocatoria && a.convocatoria.enHome !== false);

// El viaje con inscripción abierta va primero, más grande que los avisos.
const viaje = viajeDestacado();
const actividades = actividadesDestacadas();
---

<Base title="SAE UTN.BA — Servicios para estudiantes">
  <!-- ── HERO ─────────────────────────────── -->
  <!-- TEMPORAL: el hero es la Feria hasta el 8 de octubre.
       El README tiene el hero original para restaurarlo después. -->
  <section class="hero">
    <p class="hero__kicker">
      <span class="hero__punto" aria-hidden="true"></span>
      7 y 8 de octubre
    </p>
    <h1 class="hero__titulo">Feria de<br />Empleabilidad<br />2026</h1>
    <p class="hero__bajada">
      Dos jornadas con las empresas que están buscando talento UTN. Conocé a sus equipos, sumá
      herramientas y accedé a una evaluación de competencias sin costo.
    </p>

    <div class="hero__pills">
      <span class="pill pill--rojo">Miércoles 7 · Presencial</span>
      <span class="pill pill--dorado">Jueves 8 · Virtual</span>
    </div>

    <div class="hero__acciones">
      <a class="btn btn--primario hero__cta" href="/feria">
        Ver la Feria
        <Icon name="flecha" size={16} />
      </a>
      <a class="btn btn--fantasma hero__cta" href="https://luma.com/3unm2j2r" target="_blank" rel="noopener">
        Inscribirme
      </a>
    </div>
  </section>

  <div class="franja"></div>

  <!-- ── VIAJE DESTACADO ──────────────────── -->
  {
    viaje && (
      <section class="wrap">
        <a class="destacado" href={`/viajes/${viaje.slug}`}>
          <span class="destacado__etiqueta">
            <span class="destacado__punto" aria-hidden="true" />
            Viajes y eventos · Inscripción abierta
          </span>
          <span class="destacado__nombre">{viaje.nombre}</span>
          <span class="destacado__resumen">{viaje.resumen}</span>
          <span class="destacado__datos">
            <span class="destacado__dato">
              <Icon name="reloj" size={14} />
              {viaje.cuando}
            </span>
            <span class="destacado__dato">
              <Icon name="pin" size={14} />
              {viaje.donde}
            </span>
          </span>
          {viaje.cierre && <span class="destacado__cierre">{viaje.cierre}</span>}
          <span class="destacado__ir">
            Ver la convocatoria
            <Icon name="flecha" size={15} />
          </span>
        </a>
      </section>
    )
  }

  <!-- ── ACTIVIDAD DESTACADA ──────────────── -->
  {
    actividades.length > 0 && (
      <section class="wrap">
        {actividades.map((actividad) => (
        <a class="actividad" href={`/actividades/${actividad.slug}`}>
          <span class="actividad__etiqueta">{actividad.area} · Charla abierta</span>
          <span class="actividad__nombre">{actividad.nombre}</span>
          <span class="actividad__resumen">{actividad.resumen}</span>
          <span class="actividad__datos">
            <span class="actividad__dato">
              <Icon name="reloj" size={14} />
              {actividad.cuando}
            </span>
            <span class="actividad__dato">
              <Icon name="pin" size={14} />
              {actividad.donde}
            </span>
          </span>
          <span class="actividad__ir">
            Ver la charla
            <Icon name="flecha" size={15} />
          </span>
        </a>
        ))}
      </section>
    )
  }

  <!-- ── ÁREAS ────────────────────────────── -->

  {
    convocatorias.length > 0 && (
      <section class="wrap avisos">
        {convocatorias.map((area) => (
          <a class="aviso" href={`/areas/${area.slug}`}>
            <span class="aviso__texto">
              <span class="aviso__etiqueta">
                <span class="aviso__punto" aria-hidden="true" />
                {area.convocatoria!.etiqueta}
              </span>
              <span class="aviso__titulo">{area.convocatoria!.titulo}</span>
              <span class="aviso__cierre">{area.convocatoria!.cierre}</span>
            </span>
            <Icon name="flecha" size={18} />
          </a>
        ))}
      </section>
    )
  }

  <section class="wrap seccion">
    <p class="kicker">Nuestras áreas</p>
    <h2 class="titulo-seccion">¿Qué necesitás?</h2>
    <p class="bajada">
      Salud, becas, deportes, intercambios, biblioteca y acompañamiento. Tocá cualquiera para ver
      los servicios, los horarios y a quién escribirle.
    </p>

    <div class="grilla">
      {AREAS.map((area) => <AreaCard area={area} />)}
    </div>
  </section>

  <!-- ── CONTACTO RÁPIDO ──────────────────── -->
  <section class="cierre">
    <div class="wrap">
      <p class="kicker kicker--dorado">¿Dudas?</p>
      <h2 class="cierre__titulo">Escribinos y te orientamos</h2>
      <p class="cierre__bajada">
        Si no sabés a qué área corresponde tu consulta, mandanos un mail general y te derivamos.
      </p>

      <a class="btn btn--primario btn--bloque" href={`mailto:${SAE.email}`}>
        <Icon name="mail" size={17} />
        {SAE.email}
      </a>

      <div class="cierre__redes">
        <a class="red" href={SAE.instagram.url} target="_blank" rel="noopener">
          <Icon name="instagram" size={18} />
          <span>{SAE.instagram.handle}</span>
        </a>
        <a class="red" href={SAE.facebook.url} target="_blank" rel="noopener">
          <Icon name="facebook" size={18} />
          <span>{SAE.facebook.handle}</span>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    background: var(--tinta);
    color: #fff;
    padding: 40px 20px 36px;
  }

  .hero__kicker {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--titulo);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--rojo-claro);
    margin-bottom: 16px;
  }

  .hero__punto {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--rojo-claro);
    animation: latido 2.2s ease-out infinite;
  }

  @keyframes latido {
    0% {
      box-shadow: 0 0 0 0 rgba(232, 64, 96, 0.6);
    }
    70% {
      box-shadow: 0 0 0 8px rgba(232, 64, 96, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(232, 64, 96, 0);
    }
  }

  .hero__acciones {
    display: grid;
    gap: 10px;
    margin-top: 26px;
  }

  .hero__titulo {
    font-size: 34px;
    font-weight: 900;
    color: #fff;
    letter-spacing: -0.03em;
    line-height: 1.08;
  }

  .hero__bajada {
    margin-top: 16px;
    font-size: 15px;
    line-height: 1.7;
    color: #c9cfe0;
  }

  .hero__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 22px;
  }

  .hero__cta {
    text-transform: none;
    letter-spacing: 0.01em;
    font-size: 15px;
  }

  /* ── Viaje destacado ── */
  .destacado {
    display: block;
    margin-top: 24px;
    padding: 22px 20px 24px;
    background: var(--tinta);
    border-radius: var(--r-lg);
    border-left: 4px solid var(--dorado);
    box-shadow: var(--sombra-md);
    color: #c9cfe0;
    transition: transform 0.16s ease;
  }

  .destacado:active {
    transform: scale(0.99);
  }

  .destacado__etiqueta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--titulo);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--dorado);
  }

  .destacado__punto {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--dorado);
    animation: latido 2.4s ease-in-out infinite;
  }

  @keyframes latido {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.45;
      transform: scale(0.82);
    }
  }

  .destacado__nombre {
    display: block;
    margin-top: 12px;
    font-family: var(--titulo);
    font-size: 30px;
    font-weight: 900;
    color: #fff;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }

  .destacado__resumen {
    display: block;
    margin-top: 10px;
    font-size: 14.5px;
    line-height: 1.65;
    color: #c9cfe0;
  }

  .destacado__datos {
    display: grid;
    gap: 7px;
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }

  .destacado__dato {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 9px;
    align-items: start;
    font-size: 13.5px;
    line-height: 1.5;
    color: #c9cfe0;
  }

  .destacado__dato :global(svg) {
    color: var(--dorado);
    margin-top: 2px;
  }

  .destacado__cierre {
    display: block;
    margin-top: 13px;
    font-family: var(--titulo);
    font-size: 12.5px;
    font-weight: 800;
    color: #ff8fa0;
    line-height: 1.4;
  }

  .destacado__ir {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 18px;
    padding: 13px 24px;
    border-radius: var(--r-sm);
    background: var(--rojo);
    color: #fff;
    font-family: var(--titulo);
    font-size: 13.5px;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  /* ── Actividad destacada ── */
  .actividad {
    display: block;
    margin-top: 12px;
    padding: 20px 18px 22px;
    background: var(--blanco);
    border: 1px solid var(--linea);
    border-left: 4px solid var(--rojo);
    border-radius: var(--r-lg);
    box-shadow: var(--sombra-sm);
    transition: box-shadow 0.16s ease, transform 0.16s ease;
  }

  .actividad:active {
    transform: scale(0.99);
  }

  @media (hover: hover) {
    .actividad:hover {
      box-shadow: var(--sombra-md);
    }
  }

  .actividad__etiqueta {
    display: inline-block;
    border-radius: var(--r-full);
    padding: 5px 12px;
    background: var(--rojo-tenue);
    color: var(--rojo);
    font-family: var(--titulo);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .actividad__nombre {
    display: block;
    margin-top: 13px;
    font-family: var(--titulo);
    font-size: 21px;
    font-weight: 900;
    color: var(--tinta);
    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  .actividad__resumen {
    display: block;
    margin-top: 9px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--gris);
  }

  .actividad__datos {
    display: grid;
    gap: 7px;
    margin-top: 15px;
    padding-top: 15px;
    border-top: 1px solid var(--linea);
  }

  .actividad__dato {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 9px;
    align-items: start;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--tinta-2);
  }

  .actividad__dato :global(svg) {
    color: var(--rojo);
    margin-top: 2px;
  }

  .actividad__ir {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
    padding: 12px 22px;
    border-radius: var(--r-sm);
    background: var(--rojo);
    color: #fff;
    font-family: var(--titulo);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  /* ── Aviso de convocatoria ── */
  .avisos {
    display: grid;
    gap: 10px;
    padding-top: 24px;
  }

  .aviso {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 14px;
    padding: 16px;
    border: 1px solid rgba(184, 147, 62, 0.4);
    border-left: 3px solid var(--dorado);
    border-radius: var(--r-md);
    background: var(--dorado-tenue);
    color: #8a6d24;
    transition: transform 0.16s ease, box-shadow 0.16s ease;
  }

  .aviso:active {
    transform: scale(0.99);
  }

  @media (hover: hover) {
    .aviso:hover {
      box-shadow: var(--sombra-md);
    }
  }

  .aviso__etiqueta {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--titulo);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #8a6d24;
  }

  .aviso__punto {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--dorado);
    animation: latido 2.2s ease-out infinite;
  }

  @keyframes latido {
    0% {
      box-shadow: 0 0 0 0 rgba(184, 147, 62, 0.55);
    }
    70% {
      box-shadow: 0 0 0 7px rgba(184, 147, 62, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(184, 147, 62, 0);
    }
  }

  .aviso__titulo {
    display: block;
    font-family: var(--titulo);
    font-size: 16px;
    font-weight: 800;
    color: var(--tinta);
    letter-spacing: -0.01em;
    margin-top: 5px;
    line-height: 1.3;
  }

  .aviso__cierre {
    display: block;
    font-size: 13px;
    color: var(--gris);
    margin-top: 3px;
  }

  .grilla {
    display: grid;
    gap: 10px;
    margin-top: 20px;
  }

  @media (min-width: 520px) {
    .hero {
      padding: 56px 24px 48px;
    }
    .hero__titulo {
      font-size: 44px;
    }
    .hero__acciones {
      grid-auto-flow: column;
      justify-content: start;
    }
    .grilla {
      grid-template-columns: 1fr 1fr;
    }
  }

  .cierre {
    background: var(--panel);
    border-top: 1px solid var(--linea);
    padding-block: 32px 36px;
    text-align: center;
  }

  .cierre__titulo {
    font-size: 23px;
    font-weight: 900;
  }

  .cierre__bajada {
    margin: 10px 0 20px;
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--gris);
  }

  .cierre .btn {
    text-transform: none;
    letter-spacing: 0.01em;
    font-size: 14.5px;
  }

  .cierre__redes {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 16px;
    flex-wrap: wrap;
  }

  .red {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border-radius: var(--r-full);
    border: 1px solid var(--linea);
    background: var(--blanco);
    font-family: var(--titulo);
    font-size: 13px;
    font-weight: 700;
    color: var(--tinta);
  }

  .red :global(svg) {
    color: var(--rojo);
  }
</style>
