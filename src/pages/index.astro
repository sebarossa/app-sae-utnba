---
import Base from '../layouts/Base.astro';
import AreaCard from '../components/AreaCard.astro';
import Icon from '../components/Icon.astro';
import { AREAS, SAE } from '../data/areas';

// Cualquier área con una convocatoria vigente se anuncia arriba de la grilla.
const convocatorias = AREAS.filter((a) => a.convocatoria);
---

<Base title="SAE UTN.BA — Servicios para estudiantes">
  <!-- ── HERO ─────────────────────────────── -->
  <section class="hero">
    <p class="hero__kicker">Secretaría de Asuntos Estudiantiles</p>
    <h1 class="hero__titulo">Estudiar acá<br />es más que cursar.</h1>
    <p class="hero__bajada">
      Salud, becas, deportes, intercambios, biblioteca y acompañamiento. Todo lo que la SAE pone a
      disposición de los estudiantes de la UTN.BA, en un solo lugar.
    </p>

    <div class="hero__pills">
      <span class="pill pill--rojo">Sede Medrano</span>
      <span class="pill pill--dorado">Sede Campus</span>
    </div>

    <a class="btn btn--primario btn--bloque hero__cta" href="/deportes">
      Ver la oferta deportiva
      <Icon name="flecha" size={16} />
    </a>
  </section>

  <div class="franja"></div>

  <!-- ── ÁREAS ────────────────────────────── -->
  {
    convocatorias.length > 0 && (
      <section class="wrap avisos">
        {convocatorias.map((area) => (
          <a class="aviso" href={`/areas/${area.slug}`}>
            <span class="aviso__texto">
              <span class="aviso__etiqueta">
                <span class="aviso__punto" aria-hidden="true" />
                {area.convocatoria!.etiqueta}
              </span>
              <span class="aviso__titulo">{area.convocatoria!.titulo}</span>
              <span class="aviso__cierre">{area.convocatoria!.cierre}</span>
            </span>
            <Icon name="flecha" size={18} />
          </a>
        ))}
      </section>
    )
  }

  <section class="wrap seccion">
    <p class="kicker">Nuestras áreas</p>
    <h2 class="titulo-seccion">¿Qué necesitás?</h2>
    <p class="bajada">Tocá cualquiera para ver los servicios, los horarios y a quién escribirle.</p>

    <div class="grilla">
      {AREAS.map((area) => <AreaCard area={area} />)}
    </div>
  </section>

  <!-- ── CONTACTO RÁPIDO ──────────────────── -->
  <section class="cierre">
    <div class="wrap">
      <p class="kicker kicker--dorado">¿Dudas?</p>
      <h2 class="cierre__titulo">Escribinos y te orientamos</h2>
      <p class="cierre__bajada">
        Si no sabés a qué área corresponde tu consulta, mandanos un mail general y te derivamos.
      </p>

      <a class="btn btn--primario btn--bloque" href={`mailto:${SAE.email}`}>
        <Icon name="mail" size={17} />
        {SAE.email}
      </a>

      <div class="cierre__redes">
        <a class="red" href={SAE.instagram.url} target="_blank" rel="noopener">
          <Icon name="instagram" size={18} />
          <span>{SAE.instagram.handle}</span>
        </a>
        <a class="red" href={SAE.facebook.url} target="_blank" rel="noopener">
          <Icon name="facebook" size={18} />
          <span>{SAE.facebook.handle}</span>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    background: var(--tinta);
    color: #fff;
    padding: 40px 20px 36px;
  }

  .hero__kicker {
    font-family: var(--titulo);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--rojo-claro);
    margin-bottom: 16px;
  }

  .hero__titulo {
    font-size: 34px;
    font-weight: 900;
    color: #fff;
    letter-spacing: -0.03em;
    line-height: 1.08;
  }

  .hero__bajada {
    margin-top: 16px;
    font-size: 15px;
    line-height: 1.7;
    color: #c9cfe0;
  }

  .hero__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 22px;
  }

  .hero__cta {
    margin-top: 26px;
  }

  /* ── Aviso de convocatoria ── */
  .avisos {
    display: grid;
    gap: 10px;
    padding-top: 24px;
  }

  .aviso {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 14px;
    padding: 16px;
    border: 1px solid rgba(184, 147, 62, 0.4);
    border-left: 3px solid var(--dorado);
    border-radius: var(--r-md);
    background: var(--dorado-tenue);
    color: #8a6d24;
    transition: transform 0.16s ease, box-shadow 0.16s ease;
  }

  .aviso:active {
    transform: scale(0.99);
  }

  @media (hover: hover) {
    .aviso:hover {
      box-shadow: var(--sombra-md);
    }
  }

  .aviso__etiqueta {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--titulo);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #8a6d24;
  }

  .aviso__punto {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--dorado);
    animation: latido 2.2s ease-out infinite;
  }

  @keyframes latido {
    0% {
      box-shadow: 0 0 0 0 rgba(184, 147, 62, 0.55);
    }
    70% {
      box-shadow: 0 0 0 7px rgba(184, 147, 62, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(184, 147, 62, 0);
    }
  }

  .aviso__titulo {
    display: block;
    font-family: var(--titulo);
    font-size: 16px;
    font-weight: 800;
    color: var(--tinta);
    letter-spacing: -0.01em;
    margin-top: 5px;
    line-height: 1.3;
  }

  .aviso__cierre {
    display: block;
    font-size: 13px;
    color: var(--gris);
    margin-top: 3px;
  }

  .grilla {
    display: grid;
    gap: 10px;
    margin-top: 20px;
  }

  @media (min-width: 520px) {
    .hero {
      padding: 56px 24px 48px;
    }
    .hero__titulo {
      font-size: 44px;
    }
    .hero__cta {
      display: inline-flex;
      width: auto;
    }
    .grilla {
      grid-template-columns: 1fr 1fr;
    }
  }

  .cierre {
    background: var(--panel);
    border-top: 1px solid var(--linea);
    padding-block: 32px 36px;
    text-align: center;
  }

  .cierre__titulo {
    font-size: 23px;
    font-weight: 900;
  }

  .cierre__bajada {
    margin: 10px 0 20px;
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--gris);
  }

  .cierre .btn {
    text-transform: none;
    letter-spacing: 0.01em;
    font-size: 14.5px;
  }

  .cierre__redes {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 16px;
    flex-wrap: wrap;
  }

  .red {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border-radius: var(--r-full);
    border: 1px solid var(--linea);
    background: var(--blanco);
    font-family: var(--titulo);
    font-size: 13px;
    font-weight: 700;
    color: var(--tinta);
  }

  .red :global(svg) {
    color: var(--rojo);
  }
</style>
