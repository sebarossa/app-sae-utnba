---
import '../styles/global.css';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  description?: string;
  /** Ruta a la que vuelve la flecha del encabezado. Si no se pasa, no se muestra. */
  volverA?: string;
  volverTexto?: string;
}

const {
  title,
  description = 'Servicios, becas, salud y deportes de la Secretaría de Asuntos Estudiantiles de la UTN.BA.',
  volverA,
  volverTexto = 'Volver',
} = Astro.props;

const ruta = Astro.url.pathname.replace(/\/$/, '') || '/';

const nav = [
  { href: '/', label: 'Inicio', icon: 'casa' as const },
  { href: '/deportes', label: 'Deportes', icon: 'deportes' as const },
  { href: '/contacto', label: 'Contacto', icon: 'mail' as const },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#c8102e" />
    <meta name="format-detection" content="telephone=yes" />
    <title>{title}</title>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800;900&family=Open+Sans:wght@400;500;600;700&display=swap"
    />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
  </head>

  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>

    <div class="app">
      <header class="barra">
        <div class="barra__fila">
          {
            volverA ? (
              <a class="barra__volver" href={volverA}>
                <Icon name="flecha" size={18} />
                <span>{volverTexto}</span>
              </a>
            ) : (
              <img
                class="barra__logo"
                src="/utnba-blanco.png"
                width="450"
                height="125"
                alt="UTN.BA — Universidad Tecnológica Nacional, Facultad Regional Buenos Aires"
                decoding="async"
              />
            )
          }
          {
            volverA ? (
              <img
                class="barra__logo barra__logo--centro"
                src="/utnba-blanco.png"
                width="450"
                height="125"
                alt="UTN.BA"
                decoding="async"
              />
            ) : (
              <span class="barra__sec">
                Secretaría de<br />Asuntos Estudiantiles
              </span>
            )
          }
        </div>
      </header>
      <div class="franja"></div>

      <main id="contenido">
        <slot />
      </main>

      <footer class="pie">
        <img
          class="pie__logo"
          src="/utnba-blanco.png"
          width="450"
          height="125"
          alt="UTN.BA — Universidad Tecnológica Nacional, Facultad Regional Buenos Aires"
          loading="lazy"
          decoding="async"
        />
        <p class="pie__sec">Secretaría de Asuntos Estudiantiles</p>
        <p class="pie__nota">Expo Carreras UTN.BA · Sede Campus</p>
      </footer>
    </div>

    <nav class="nav-inferior" aria-label="Navegación principal">
      {
        nav.map((item) => {
          const activo = item.href === '/' ? ruta === '/' : ruta.startsWith(item.href);
          return (
            <a href={item.href} class:list={['nav-inferior__item', { activo }]} aria-current={activo ? 'page' : undefined}>
              <Icon name={item.icon} size={22} />
              <span>{item.label}</span>
            </a>
          );
        })
      }
    </nav>

    <style>
      .saltar {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--tinta);
        color: #fff;
        padding: 12px 18px;
        z-index: 50;
      }
      .saltar:focus {
        left: 8px;
        top: 8px;
      }

      .barra {
        background: var(--rojo);
        padding: calc(env(safe-area-inset-top, 0px) + 12px) 20px 12px;
        position: sticky;
        top: 0;
        z-index: 20;
      }

      .barra__fila {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        min-height: 34px;
      }

      .barra__logo {
        height: 32px;
        width: auto;
        flex: none;
      }

      /* En páginas internas la flecha ocupa la izquierda, así que el logo se centra. */
      .barra__logo--centro {
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
        height: 26px;
      }

      .barra__sec {
        font-family: var(--titulo);
        font-size: 10px;
        font-weight: 700;
        line-height: 1.45;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        text-align: right;
        color: rgba(255, 255, 255, 0.82);
      }

      .barra__volver {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-family: var(--titulo);
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #fff;
        margin: -8px 0 -8px -6px;
        padding: 8px 6px;
      }

      .barra__volver :global(svg) {
        transform: rotate(180deg);
      }

      .pie {
        background: var(--rojo);
        color: #fff;
        text-align: center;
        padding: 26px 24px calc(26px + env(safe-area-inset-bottom, 0px));
      }

      .pie__logo {
        height: 34px;
        width: auto;
        margin: 0 auto 12px;
      }

      .pie__sec {
        font-size: 11.5px;
        color: rgba(255, 255, 255, 0.78);
      }

      .pie__nota {
        font-size: 10.5px;
        color: rgba(255, 255, 255, 0.6);
        margin-top: 10px;
        letter-spacing: 0.04em;
      }

      .nav-inferior {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 30;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        background: rgba(255, 255, 255, 0.94);
        backdrop-filter: saturate(180%) blur(14px);
        -webkit-backdrop-filter: saturate(180%) blur(14px);
        border-top: 1px solid var(--linea);
        padding-bottom: var(--safe-b);
        max-width: var(--ancho);
        margin-inline: auto;
      }

      .nav-inferior__item {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 3px;
        height: var(--nav-h);
        font-family: var(--titulo);
        font-size: 10.5px;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--gris-2);
        transition: color 0.15s ease;
      }

      .nav-inferior__item.activo {
        color: var(--rojo);
      }

      .nav-inferior__item:active {
        color: var(--rojo);
      }
    </style>
  </body>
</html>
